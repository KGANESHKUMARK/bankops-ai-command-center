# BankOps AI Command Center — Vercel configuration
# Deploys the frontend as a static site. The backend must be hosted separately
# (e.g., on Railway, Fly.io, or any container platform). Set VITE_API_BASE_URL
# to the backend's public URL in Vercel environment variables.
#
# SYNTHETIC DEMO ONLY.

[build]
  command = "cd frontend && npm ci && npm run build"
  publish = "frontend/dist"

[[redirects]]
  from = "/api/*"
  to = "${VITE_API_BASE_URL}/:splat"
  status = 200
  force = true

[[redirects]]
  from = "/*"
  to = "/index.html"
  status = 200
