# Frontend build-time configuration (public values only - NEVER put secrets in VITE_* variables;
# everything prefixed VITE_ is embedded in the browser bundle).
#
# Base URL for API calls made by the browser. Default "/api" (same-origin; Vite dev/preview, nginx and the
# Vercel rewrite proxy it to the backend). For a cross-origin backend set the full URL and add the frontend
# origin to the backend's CORS_ALLOWED_ORIGINS.
VITE_API_BASE_URL=/api

# Dev/preview server only (not embedded in the bundle): where the /api proxy forwards requests.
# BANKOPS_API_PROXY_TARGET=http://127.0.0.1:8000
