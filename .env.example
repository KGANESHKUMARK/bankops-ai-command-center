# =====================================================================================
# BankOps AI Command Center - environment example (SYNTHETIC DEMO)
# Copy to `.env` for LOCAL/DEMO use only:   cp .env.example .env
# `.env` is git-ignored. Never commit real secrets.
# =====================================================================================

# --- Environment -------------------------------------------------------------------
# local | demo | test | staging | production
APP_ENV=local
# Demo mode enables seeded demo accounts, demo reset and failure injection. MUST be false in staging/production.
DEMO_MODE=true
EXPOSE_API_DOCS=true

# --- Database ----------------------------------------------------------------------
# Local fallback (no services required). Vector search uses in-process cosine similarity.
DATABASE_URL=sqlite:///./backend/data/bankops_demo.db
# PostgreSQL + pgvector (docker compose sets this automatically for the backend container):
# DATABASE_URL=postgresql+psycopg://bankops:bankops_local_only@localhost:5432/bankops

# --- Authentication ------------------------------------------------------------------
# Leave empty locally to use an ephemeral per-process secret. REQUIRED (>=32 random chars) in staging/production.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_TTL_MINUTES=30
# LOCAL-ONLY password for all seeded demo accounts. Startup refuses to run in staging/production if this is set.
DEMO_PASSWORD=BankOpsDemo!2026

# --- HTTP hardening --------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080
MAX_REQUEST_BODY_BYTES=1048576
MAX_UPLOAD_BYTES=2097152
RATE_LIMIT_PER_MINUTE=240
LOGIN_RATE_LIMIT_PER_MINUTE=10

# --- Model gateway -----------------------------------------------------------------------
# mock = deterministic offline provider (no network, no key). Output is labeled MOCK MODE.
LLM_PROVIDER=mock
# For an OpenAI-compatible provider (never required for the demo):
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=            # set in your shell or secret manager, never commit
# LLM_MODEL=gpt-4o-mini
# LLM_APPROVED_MODELS=gpt-4o-mini,gpt-4.1-mini
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_JUDGE_ENABLED=false

# hashing = deterministic offline embeddings; openai_compatible uses EMBEDDING_BASE_URL/EMBEDDING_API_KEY.
EMBEDDING_PROVIDER=hashing
EMBEDDING_DIM=384
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=

# Cost ESTIMATES (USD per 1K tokens) - shown as estimates only.
COST_PER_1K_INPUT_TOKENS=0.00015
COST_PER_1K_OUTPUT_TOKENS=0.0006

# --- Workflow bounds -----------------------------------------------------------------------
WORKFLOW_MAX_STEPS=16
WORKFLOW_MAX_TOOL_CALLS=30
WORKFLOW_TOKEN_BUDGET=60000
WORKFLOW_EXECUTION_MODE=background

# --- Policy --------------------------------------------------------------------------------
APPROVAL_TTL_MINUTES=60
MEDIUM_RISK_REQUIRES_APPROVAL=true
LOW_RISK_REQUIRES_APPROVAL=false

# --- Seeding -------------------------------------------------------------------------------
# docker compose seeds via the entrypoint; leave false for manual `python -m app.cli seed`.
SEED_ON_STARTUP=false
